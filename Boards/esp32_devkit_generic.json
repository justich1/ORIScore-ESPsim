    "GPIO2": 2,
    "GPIO4": 4,
    "GPIO5": 5,
    "GPIO12": 12,
    "GPIO13": 13,
    "GPIO14": 14,
    "GPIO15": 15,
    "GPIO16": 16,
    "GPIO17": 17,
    "GPIO18": 18,
    "GPIO19": 19,
    "GPIO21": 21,
    "GPIO22": 22,
