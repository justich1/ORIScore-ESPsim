  "uart": [
    {
      "name": "Serial",
      "tx": 1,
      "rx": 3,
      "baud": 115200,
      "console": true,
      "role": "USB serial / UART0"
    },
    {
      "name": "Serial1",
      "tx": 10,
      "rx": 9,
      "baud": 115200,
      "console": false,
      "role": "UART1 / často koliduje s flash na některých deskách"
    },
    {
      "name": "Serial2",
      "tx": 17,
      "rx": 16,
      "baud": 9600,
      "console": false,
      "role": "UART2"
    }
  ],

  "oneWire": [
    {
      "name": "OneWire bus",
      "defaultPin": "GPIO4",
      "gpio": 4,
      "supportedDevices": [
        "DS18B20"
      ]
    }
  ],

  "i2c": [
    {
      "name": "Default I2C",
      "sda": 21,
      "scl": 22
    }
  ],

  "spi": [
    {
      "name": "VSPI",
      "sck": 18,
      "miso": 19,
      "mosi": 23,
      "cs": 5
